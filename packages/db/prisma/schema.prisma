generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum ApplicantStatus {
  admitted
  not_admitted
  absent
  disqualified
}

enum AdmissionOption {
  first
  second
}

// ── Shared spine ─────────────────────────────────────────────────────────────

model University {
  id        Int     @id @default(autoincrement())
  name      String
  shortName String?
  acronym   String  @unique
  location  String?
  color     String
  status    String  @default("active")

  careers   Career[]
  processes Process[]

  @@map("universities")
}

model Career {
  id           Int     @id @default(autoincrement())
  universityId Int
  code         String
  name         String
  area         String?
  faculty      String?

  university University @relation(fields: [universityId], references: [id])
  programs   Program[]

  @@unique([universityId, code])
  @@index([universityId, area])
  @@map("careers")
}

model Process {
  id              Int       @id @default(autoincrement())
  universityId    Int
  slug            String
  period          String
  examYear        Int
  examSemester    String
  totalApplicants Int?
  totalAdmitted   Int?
  publishedAt     DateTime?
  regulationUrl   String?

  university             University             @relation(fields: [universityId], references: [id])
  examDates              ExamDate[]
  programs               Program[]
  unmsmProcess           UnmsmProcess?
  unmsmProcessModalities UnmsmProcessModality[]
  unmsmApplicants        UnmsmApplicant[]

  @@unique([universityId, slug])
  @@map("processes")
}

model ExamDate {
  id        Int      @id @default(autoincrement())
  processId Int
  date      DateTime @db.Date
  area      String?
  examType  String
  note      String?

  process Process @relation(fields: [processId], references: [id])

  @@map("exam_dates")
}

model Program {
  id              Int    @id @default(autoincrement())
  processId       Int
  careerId        Int
  campus          String
  vacancies       Int?
  cutoffScore     Float?
  totalApplicants Int?
  totalAdmitted   Int?
  admissionRate   Float?

  process         Process          @relation(fields: [processId], references: [id])
  career          Career           @relation(fields: [careerId], references: [id])
  unmsmApplicants UnmsmApplicant[]

  @@unique([processId, careerId, campus])
  @@index([processId, careerId])
  @@map("programs")
}

// ── UNMSM-specific ───────────────────────────────────────────────────────────

model UnmsmProcess {
  processId         Int     @id
  isPartialProcess  Boolean
  hasAreas          Boolean
  hasMinScoreFilter Boolean
  minScoreThreshold Int?
  hasSecondChoice   Boolean

  process Process @relation(fields: [processId], references: [id])

  @@map("unmsm_processes")
}

model UnmsmModality {
  id       Int    @id @default(autoincrement())
  code     String @unique
  name     String
  examType String

  processModalities UnmsmProcessModality[]
  applicants        UnmsmApplicant[]

  @@map("unmsm_modalities")
}

model UnmsmProcessModality {
  processId  Int
  modalityId Int

  process  Process       @relation(fields: [processId], references: [id])
  modality UnmsmModality @relation(fields: [modalityId], references: [id])

  @@id([processId, modalityId])
  @@map("unmsm_process_modalities")
}

model UnmsmApplicant {
  id         Int    @id @default(autoincrement())
  processId  Int
  programId  Int
  modalityId Int
  code       String
  fullName   String
  campus     String

  process  Process       @relation(fields: [processId], references: [id])
  program  Program       @relation(fields: [programId], references: [id])
  modality UnmsmModality @relation(fields: [modalityId], references: [id])
  result   UnmsmResult?

  @@unique([processId, code])
  @@index([programId])
  @@map("unmsm_applicants")
}

model UnmsmResult {
  id              Int              @id @default(autoincrement())
  applicantId     Int              @unique
  score           Float
  rank            Int?
  observation     String
  status          ApplicantStatus
  admissionOption AdmissionOption?
  scrapedAt       DateTime

  applicant UnmsmApplicant @relation(fields: [applicantId], references: [id])

  @@index([score])
  @@map("unmsm_results")
}
